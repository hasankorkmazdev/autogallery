@model StockPageModel
@{
    var options = (Dictionary<string, List<EnumOption>>)ViewBag.FilterOptions;
    var f = Model.Filter;
    var heading = Model.SeriesName != null ? $"{Model.BrandName} {Model.SeriesName}" : Model.BrandName ?? "Stoktaki Araçlar";
    var basePath = "/stok" + (f.Brand != null ? $"/{f.Brand}" : "") + (f.Series != null ? $"/{f.Series}" : "");
    ViewData["Title"] = Model.BrandName == null ? "Stok" : $"{heading} ilanları";
    ViewData["Description"] = $"{heading}: {Model.TotalCount} araç. Boya / değişen, Tramer ve donanım bilgileriyle.";
    ViewData["Canonical"] = basePath;

    string PageUrl(int page)
    {
        var query = Context.Request.Query
            .Where(x => x.Key != "page" && !string.IsNullOrEmpty(x.Value))
            .SelectMany(x => x.Value.Select(v => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(v)}"))
            .ToList();
        if (page > 1)
            query.Add($"page={page}");
        return query.Count == 0 ? basePath : $"{basePath}?{string.Join("&", query)}";
    }

    string Selected(bool condition) => condition ? "selected" : null;
}

<section class="section">
    <div class="container">
        <nav class="breadcrumb" aria-label="Konum">
            <a href="/">Ana Sayfa</a> /
            <a href="/stok">Stok</a>
            @if (Model.BrandName != null)
            {
                <span>/</span> <a href="/stok/@f.Brand">@Model.BrandName</a>
            }
            @if (Model.SeriesName != null)
            {
                <span>/</span> <span>@Model.SeriesName</span>
            }
        </nav>
        <div class="section-head">
            <h1 class="display">@heading</h1>
            <p class="muted">@Model.TotalCount araç</p>
        </div>

        <div class="stock-layout">
            <form class="filters" method="get" action="/stok" data-stock-filter>
                <label>Marka
                    <select name="brand">
                        <option value="">Tümü</option>
                        @foreach (var b in Model.Brands)
                        {
                            <option value="@b.Value" selected="@Selected(b.Value == f.Brand)">@b.Label (@b.Count)</option>
                        }
                    </select>
                </label>
                @if (Model.Series.Count > 0)
                {
                    <label>Seri
                        <select name="series">
                            <option value="">Tümü</option>
                            @foreach (var s in Model.Series)
                            {
                                <option value="@s.Value" selected="@Selected(s.Value == f.Series)">@s.Label (@s.Count)</option>
                            }
                        </select>
                    </label>
                }
                <label>Yakıt
                    <select name="fuel">
                        <option value="">Tümü</option>
                        @foreach (var o in options["fuel"])
                        {
                            <option value="@o.Value" selected="@Selected((int?)f.Fuel == o.Value)">@o.Label</option>
                        }
                    </select>
                </label>
                <label>Vites
                    <select name="transmission">
                        <option value="">Tümü</option>
                        @foreach (var o in options["transmission"])
                        {
                            <option value="@o.Value" selected="@Selected((int?)f.Transmission == o.Value)">@o.Label</option>
                        }
                    </select>
                </label>
                <label>Kasa Tipi
                    <select name="body">
                        <option value="">Tümü</option>
                        @foreach (var o in options["body"])
                        {
                            <option value="@o.Value" selected="@Selected((int?)f.Body == o.Value)">@o.Label</option>
                        }
                    </select>
                </label>
                <div class="range">
                    <label>Yıl (en az)<input type="number" name="yearMin" value="@f.YearMin" min="1950" max="2100" inputmode="numeric" /></label>
                    <label>Yıl (en çok)<input type="number" name="yearMax" value="@f.YearMax" min="1950" max="2100" inputmode="numeric" /></label>
                </div>
                <div class="range">
                    <label>Fiyat (en az)<input type="number" name="priceMin" value="@f.PriceMin" min="0" step="1000" inputmode="numeric" /></label>
                    <label>Fiyat (en çok)<input type="number" name="priceMax" value="@f.PriceMax" min="0" step="1000" inputmode="numeric" /></label>
                </div>
                <label>Kilometre (en çok)<input type="number" name="kmMax" value="@f.KmMax" min="0" step="1000" inputmode="numeric" /></label>
                <label>Sıralama
                    <select name="sort">
                        <option value="">En yeni</option>
                        <option value="fiyat-artan" selected="@Selected(f.Sort == "fiyat-artan")">Fiyat (artan)</option>
                        <option value="fiyat-azalan" selected="@Selected(f.Sort == "fiyat-azalan")">Fiyat (azalan)</option>
                        <option value="km" selected="@Selected(f.Sort == "km")">Kilometre (düşük)</option>
                        <option value="yil" selected="@Selected(f.Sort == "yil")">Yıl (yeni)</option>
                    </select>
                </label>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary">Filtrele</button>
                    <a class="btn btn-outline" href="/stok">Temizle</a>
                </div>
            </form>

            <div>
                @if (Model.Items.Count == 0)
                {
                    <div class="empty">
                        <p>Bu filtrelere uyan araç bulunamadı.</p>
                        <a class="btn btn-outline" href="/stok">Filtreleri temizle</a>
                    </div>
                }
                else
                {
                    <div class="grid grid-stock">
                        @foreach (var item in Model.Items)
                        {
                            <partial name="_VehicleCard" model="item" />
                        }
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination" aria-label="Sayfalar">
                        @if (Model.Page > 1)
                        {
                            <a href="@PageUrl(Model.Page - 1)" rel="prev">Önceki</a>
                        }
                        <span>Sayfa @Model.Page / @Model.TotalPages</span>
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a href="@PageUrl(Model.Page + 1)" rel="next">Sonraki</a>
                        }
                    </nav>
                }
            </div>
        </div>
    </div>
</section>
