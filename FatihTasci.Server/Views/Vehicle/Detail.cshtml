@model PublicVehicleDetailModel
@inject FatihTasci.Core.Service.Domains.Abstracts.ISiteSettingService SettingService
@inject FatihTasci.Core.Service.Domains.Abstracts.IShareImageService ShareImages
@{
    var settings = await SettingService.GetAsync();
    var price = SiteFormat.EffectivePrice(Model.Price, Model.CampaignPrice, Model.ShowPrice);
    var priceTag = SiteFormat.PriceTag(Model.Price, Model.CampaignPrice, Model.ShowPrice);
    var saving = SiteFormat.HasCampaign(Model.Price, Model.CampaignPrice, Model.ShowPrice)
        ? SiteFormat.Money(Model.Price.Value - Model.CampaignPrice.Value)
        : null;
    var badge = SiteFormat.StatusBadge(Model.Status);
    var isSold = Model.Status == VehicleStatus.Sold;
    var whatsAppMessage = $"Merhaba, {Model.ListingNo} numaralı ilan ({Model.Title}) hakkında bilgi almak istiyorum.";
    // Danışmanın telefonu varsa "Ara" onu arar; cep telefonuysa WhatsApp da ona gider. Yoksa galerinin numaraları.
    var contactPhone = string.IsNullOrWhiteSpace(Model.AdvisorPhone) ? settings.Phone : Model.AdvisorPhone;
    var whatsAppNumber = SiteFormat.MobileToWhatsApp(Model.AdvisorPhone) ?? settings.WhatsApp;
    var whatsApp = SiteFormat.WhatsAppLink(whatsAppNumber, whatsAppMessage);
    var tel = SiteFormat.TelLink(contactPhone);
    var cover = Model.Images.FirstOrDefault();

    var baseUrl = Urls.Base(Context.Request);
    var shareCard = ShareCards.ForVehicle(Model.Share, settings);
    var effectivePrice = SiteFormat.HasCampaign(Model.Price, Model.CampaignPrice, Model.ShowPrice) ? Model.CampaignPrice : Model.Price;

    ViewData["Title"] = Model.Title;
    ViewData["Description"] = $"{Model.Title} — {string.Join(" · ", Model.Summary)}. {(isSold ? "Satıldı" : price)}. İlan No: {Model.ListingNo}.";
    ViewData["Canonical"] = Model.Url;
    // Paylaşım görseli: içerik (fiyat, başlık, kapak) değişince ?v= de değişir, platformlar yeni görseli çeker.
    ViewData["OgImage"] = ShareCards.VehicleImagePath(Model.ListingNo, ShareImages.ComputeVersion(shareCard));
    ViewData["OgImageAlt"] = Model.Title;
    ViewData["OgType"] = "product";
    ViewData["WhatsAppMessage"] = whatsAppMessage;
    ViewData["PageWhatsApp"] = whatsApp;
    ViewData["PageTel"] = tel;
}
@section Head {
    @if (!isSold && Model.ShowPrice && effectivePrice > 0)
    {
        <meta property="product:price:amount" content="@effectivePrice.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
        <meta property="product:price:currency" content="TRY" />
    }
    <meta property="product:availability" content="@(isSold ? "out of stock" : "in stock")" />
    <meta property="product:condition" content="@(Model.Condition == VehicleCondition.New ? "new" : "used")" />
    @StructuredData.Script(StructuredData.Vehicle(Model, settings, baseUrl))
    @StructuredData.Script(StructuredData.Breadcrumb(baseUrl,
        ("Ana Sayfa", "/"), ("Tüm İlanlar", "/ilanlar"),
        (Model.BrandName, $"/ilanlar/{Model.BrandSlug}"),
        (Model.SeriesName, $"/ilanlar/{Model.BrandSlug}/{Model.SeriesSlug}"),
        (Model.Title, Model.Url)))
}

<section class="section vehicle">
    <div class="container">
        <nav class="breadcrumb" aria-label="Konum">
            <a href="/">Ana Sayfa</a> / <a href="/ilanlar">Tüm İlanlar</a> /
            <a href="/ilanlar/@Model.BrandSlug">@Model.BrandName</a> /
            <a href="/ilanlar/@Model.BrandSlug/@Model.SeriesSlug">@Model.SeriesName</a>
        </nav>

        <div class="vehicle-head">
            <div class="vehicle-title">
                @if (!string.IsNullOrEmpty(Model.BrandLogoUrl))
                {
                    <a class="brand-logo brand-logo-lg" href="/ilanlar/@Model.BrandSlug" title="@Model.BrandName ilanları"><img src="@Model.BrandLogoUrl" alt="@Model.BrandName" width="56" height="56" /></a>
                }
                <div>
                    <h1 class="display">@Model.Title</h1>
                    @if (Model.Summary.Count > 0)
                    {
                        <ul class="chips">
                            @foreach (var item in Model.Summary)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <span class="listing-no">İlan No <strong>@Model.ListingNo</strong></span>
        </div>

        @if (isSold)
        {
            <div class="notice">Bu araç satıldı. Benzer araçlarımıza aşağıdan göz atabilirsiniz.</div>
        }

        @* İki bağımsız sütun: solda galeri ve ayrıntılar, sağda fiyat + teknik özellikler ve talep formu.
           Mobilde sütunlar açılır (display: contents); sıra: galeri, fiyat/özellikler, ayrıntılar, form. *@
        <div class="vehicle-layout">
            <div class="vehicle-col-main">
                <div class="gallery" data-gallery>
                    @if (cover == null)
                    {
                        <div class="gallery-main card-placeholder">Fotoğraf yok</div>
                    }
                    else
                    {
                        @* JavaScript kapalıysa bağlantı büyük fotoğrafı açar; açıksa tam ekran galeri (lightbox) açılır. *@
                        <a class="gallery-main" href="@cover.LargeUrl" target="_blank" rel="noopener" data-gallery-main
                           aria-label="Fotoğrafları tam ekran aç">
                            <img src="@cover.MediumUrl" alt="@cover.Alt" width="@cover.Width" height="@cover.Height" data-gallery-image />
                            <span class="gallery-hint" aria-hidden="true">⤢ Tam ekran · @Model.Images.Count fotoğraf</span>
                        </a>
                        <div class="gallery-thumbs">
                            @for (var i = 0; i < Model.Images.Count; i++)
                            {
                                var image = Model.Images[i];
                                <button type="button" class="thumb @(i == 0 ? "active" : null)" data-medium="@image.MediumUrl" data-large="@image.LargeUrl" aria-label="Fotoğraf @(i + 1)">
                                    <img src="@image.SmallUrl" alt="" loading="lazy" />
                                </button>
                            }
                        </div>

                        <dialog class="lightbox lightbox-vehicle" data-lightbox aria-label="@Model.Title fotoğrafları">
                            <div class="lightbox-bar">
                                <span class="lightbox-count" aria-live="polite"><strong data-lightbox-index>1</strong> / @Model.Images.Count</span>
                                <span class="lightbox-title">@Model.Title</span>
                                <button type="button" class="icon-btn" data-lightbox-close aria-label="Kapat">✕</button>
                            </div>
                            <div class="lightbox-stage" data-lightbox-stage>
                                <img class="lightbox-photo" src="" alt="" data-lightbox-img draggable="false" />
                                @if (Model.Images.Count > 1)
                                {
                                    <button type="button" class="icon-btn lightbox-prev" data-lightbox-prev aria-label="Önceki fotoğraf">←</button>
                                    <button type="button" class="icon-btn lightbox-next" data-lightbox-next aria-label="Sonraki fotoğraf">→</button>
                                }
                            </div>
                            @if (Model.Images.Count > 1)
                            {
                                <div class="lightbox-strip">
                                    @for (var i = 0; i < Model.Images.Count; i++)
                                    {
                                        var image = Model.Images[i];
                                        <button type="button" class="lightbox-thumb" data-lightbox-thumb data-large="@image.LargeUrl" data-alt="@image.Alt" aria-label="Fotoğraf @(i + 1)">
                                            <img src="@image.SmallUrl" alt="" loading="lazy" />
                                        </button>
                                    }
                                </div>
                            }
                            <p class="lightbox-help" aria-hidden="true">Sonraki fotoğraf için fotoğrafa tıklayın · ← → ile gezinin · Esc ile kapatın</p>
                        </dialog>
                    }
                </div>

                <div class="vehicle-details">
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <section class="panel">
                            <h2 class="panel-title">Açıklama</h2>
                            @* Açıklama kayıt sırasında HtmlSanitizer ile temizlenir (VehicleService.SanitizeDescription) *@
                            <div class="prose description">@Html.Raw(Model.Description)</div>
                        </section>
                    }

                    <section class="panel">
                        <h2 class="panel-title">Boya, Değişen ve Tramer</h2>
                        <partial name="_DamageDiagram" model="Model.BodyParts" />
                        <dl class="specs specs-inline">
                            <div><dt>Tramer</dt><dd>@(Model.TramerAmount > 0 ? SiteFormat.Money(Model.TramerAmount.Value) : "Kayıt yok")</dd></div>
                            <div><dt>Ağır hasar kaydı</dt><dd>@(Model.HeavyDamageRecord ? "Var" : "Yok")</dd></div>
                        </dl>
                        @if (Model.ExpertiseReportUrl != null)
                        {
                            <a class="btn btn-outline" href="@Model.ExpertiseReportUrl" target="_blank" rel="noopener">Ekspertiz raporunu indir (PDF)</a>
                        }
                    </section>

                    @if (Model.Features.Count > 0)
                    {
                        <section class="panel">
                            <h2 class="panel-title">Donanım</h2>
                            <div class="features">
                                @foreach (var group in Model.Features)
                                {
                                    <div>
                                        <h3>@group.CategoryName</h3>
                                        <ul>
                                            @foreach (var feature in group.Features)
                                            {
                                                <li>@feature</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (Model.VideoEmbedUrl != null)
                    {
                        <section class="panel">
                            <h2 class="panel-title">Video</h2>
                            <div class="video">
                                <iframe src="@Model.VideoEmbedUrl" title="@Model.Title videosu" loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
                            </div>
                        </section>
                    }
                    else if (Model.VideoUrl != null)
                    {
                        <p><a href="@Model.VideoUrl" target="_blank" rel="noopener">Aracın videosunu izleyin</a></p>
                    }
                </div>
            </div>

            <aside class="vehicle-col-side">
                <section class="panel vehicle-specs" aria-labelledby="specs-title">
                    @* Fiyat, fotoğrafın üst hizasında: sağ sütunun en üstü *@
                    <div class="vehicle-price">
                        @if (badge != null)
                        {
                            <span class="badge badge-@Model.Status.ToString().ToLowerInvariant()">@badge</span>
                        }
                        @if (!isSold)
                        {
                            <div class="price">@priceTag</div>
                            @if (saving != null)
                            {
                                <p class="price-saving">Kampanya: @saving indirim</p>
                            }
                        }
                    </div>
                    <h2 id="specs-title" class="panel-title">Teknik Özellikler</h2>
                    <dl class="specs specs-single">
                        @foreach (var spec in Model.Specs)
                        {
                            <div><dt>@spec.Label</dt><dd>@spec.Value</dd></div>
                        }
                    </dl>
                </section>
                <div class="panel vehicle-contact">
                    @if (!isSold)
                    {
                        <div class="price">@priceTag</div>
                        @if (saving != null)
                        {
                            <p class="price-saving">Kampanya: @saving indirim</p>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.AdvisorName))
                    {
                        <div class="contact-person">
                            <span class="muted">Satış danışmanı</span>
                            <strong>@Model.AdvisorName</strong>
                        </div>
                    }
                    <div class="contact-actions">
                        @if (whatsApp != null)
                        {
                            <a class="btn btn-primary" href="@whatsApp" target="_blank" rel="noopener">WhatsApp ile yaz</a>
                        }
                        @if (tel != null)
                        {
                            <a class="btn btn-outline" href="@tel">Ara: @contactPhone</a>
                        }
                    </div>
                    @if (!isSold && MapLinks.HasLocation(settings))
                    {
                        <p class="contact-location muted">Aracı galerimizde görebilirsiniz. <a href="@MapLinks.Directions(settings)" target="_blank" rel="noopener">Yol tarifi al</a></p>
                    }

                    @if (!isSold)
                    {
                        <div id="talep">
                            @if (TempData["FormSuccess"] is string success)
                            {
                                <div class="alert alert-success">@success</div>
                            }
                            @if (TempData["FormError"] is string error)
                            {
                                <div class="alert alert-error">@error</div>
                            }
                            <h2 class="panel-title">Bilgi al / Test sürüşü</h2>
                            <form method="post" action="/talep" class="form" autocomplete="off">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ListingNo" value="@Model.ListingNo" />
                                <input type="hidden" name="returnUrl" value="@Model.Url" />
                                <div class="hp" aria-hidden="true"><label>Web sitesi<input type="text" name="Website" tabindex="-1" autocomplete="off" /></label></div>
                                <label>Talep türü
                                    <select name="Type" data-lead-type>
                                        <option value="@((int)LeadType.Information)">Bilgi almak istiyorum</option>
                                        <option value="@((int)LeadType.TestDrive)">Test sürüşü talep ediyorum</option>
                                    </select>
                                </label>
                                <label>Ad soyad<input type="text" name="FullName" required maxlength="100" autocomplete="off" /></label>
                                <label>Telefon<input type="tel" name="Phone" required maxlength="20" autocomplete="off" /></label>
                                <label>E-posta (isteğe bağlı)<input type="email" name="Email" maxlength="150" autocomplete="off" /></label>
                                <label data-preferred-date hidden>Tercih ettiğiniz tarih<input type="date" name="PreferredDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
                                <label>Mesajınız (isteğe bağlı)<textarea name="Message" rows="3" maxlength="2000"></textarea></label>
                                <label class="checkbox"><input type="checkbox" name="KvkkConsent" value="true" required /> <span><a href="/kvkk" target="_blank">Aydınlatma metnini</a> okudum, kişisel verilerimin işlenmesine onay veriyorum.</span></label>
                                <button type="submit" class="btn btn-primary">Gönder</button>
                            </form>
                        </div>
                    }
                </div>
            </aside>
        </div>

        @if (Model.Similar.Count > 0)
        {
            <section class="section-tight">
                <h2 class="section-title">Benzer Araçlar</h2>
                <div class="grid">
                    @foreach (var item in Model.Similar)
                    {
                        <partial name="_VehicleCard" model="item" />
                    }
                </div>
            </section>
        }
    </div>
</section>
