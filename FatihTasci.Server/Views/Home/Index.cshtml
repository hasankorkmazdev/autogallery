@model HomePageModel
@inject FatihTasci.Core.Service.Domains.Abstracts.ISiteSettingService SettingService
@inject FatihTasci.Core.Service.Domains.Abstracts.ISiteContentService ContentService
@{
    var settings = await SettingService.GetAsync();
    var content = await ContentService.GetAsync();
    var baseUrl = Urls.Base(Context.Request);
    ViewData["Canonical"] = "/";
}
@section Head {
    @StructuredData.Script(StructuredData.Dealer(settings, baseUrl, baseUrl + ShareCards.SiteImagePath))
    @StructuredData.Script(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = SiteFormat.GalleryName(settings),
        ["url"] = baseUrl + "/"
    })
}
<partial name="_Intro" model="Model" />
<partial name="_Showcase" model="Model" />

@if (Model.Brands.Count > 0)
{
    <section class="section" aria-labelledby="brands-title">
        <div class="container">
            <div class="section-head">
                <h2 id="brands-title" class="section-title">Markalar</h2>
            </div>
            <partial name="_BrandStrip" model="Model.Brands" view-data='new ViewDataDictionary(ViewData) { ["BrandVariant"] = "tiles" }' />
        </div>
    </section>
}

<partial name="_Services" model="content.Services" />
<partial name="_Stats" model="content.Stats" />

<partial name="_Atmosphere" model="Model.Scenes" />

<partial name="_Deliveries" model="Model.Deliveries" />

<partial name="_Location" model="settings" />
