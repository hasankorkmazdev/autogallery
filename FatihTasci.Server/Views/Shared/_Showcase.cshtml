@model HomePageModel
@*
    Ana sayfa araç kaydırıcısı (girişin altında). Sekmeler: Vitrindekiler (panelde "Vitrinde öne çıkar" işaretliler vitrin
    sırasıyla, eksikse en yeniler; PublicVehicleService.ShowcaseSize), Fırsat Araçları ("Fırsat aracı" işaretliler) ve
    Yeni Gelenler (Vitrindekiler'de olmayan en yeniler). Her sekme yana kayan kart sırasıdır. Sekmeler ve oklar
    site.js [data-rails]; JS yoksa sekme düğmeleri ve oklar gizli kalır, listeler başlıklarıyla alt alta görünür.
*@
@{
    var tabs = new List<(string Id, string Name, List<VehicleCardModel> Items)>
    {
        ("vitrin", "Vitrindekiler", Model.Showcase),
        ("firsat", "Fırsat Araçları", Model.Opportunities),
        ("yeni", "Yeni Gelenler", Model.Latest)
    }.Where(t => t.Items.Count > 0).ToList();
}
<section class="section rails" id="vitrin" data-rails aria-labelledby="rails-title">
    <div class="container">
        <div class="section-head">
            <h2 id="rails-title" class="section-title">Öne çıkan araçlar</h2>
            <div class="section-tools">
                <a class="link-more" href="/ilanlar">Tüm ilanlar <span class="muted">(@Model.ListingCount)</span> <span aria-hidden="true">›</span></a>
                @if (tabs.Count > 0)
                {
                    <div class="rail-arrows" data-rail-arrows hidden>
                        <button type="button" class="icon-btn" data-rail-prev aria-label="Önceki araçlar">←</button>
                        <button type="button" class="icon-btn" data-rail-next aria-label="Sonraki araçlar">→</button>
                    </div>
                }
            </div>
        </div>

        @if (tabs.Count == 0)
        {
            <p class="muted">Şu anda yayında araç bulunmuyor.</p>
        }
        else
        {
            @if (tabs.Count > 1)
            {
                <div class="tabs" role="tablist" aria-label="Araç listeleri" data-rail-tabs hidden>
                    @for (var i = 0; i < tabs.Count; i++)
                    {
                        var tab = tabs[i];
                        <button type="button" class="tab @(i == 0 ? "is-active" : null)" role="tab" id="rail-tab-@tab.Id"
                                aria-controls="rail-@tab.Id" aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? "0" : "-1")"
                                data-rail-tab>@tab.Name</button>
                    }
                </div>
            }
            @foreach (var tab in tabs)
            {
                @* Razor null değerli özniteliği yazmaz: tek liste varsa sekme rolü yok *@
                <div class="rail" id="rail-@tab.Id" data-rail role="@(tabs.Count > 1 ? "tabpanel" : null)"
                     aria-labelledby="@(tabs.Count > 1 ? $"rail-tab-{tab.Id}" : null)">
                    <h3 class="rail-title" data-rail-title>@tab.Name</h3>
                    <div class="rail-track" data-rail-track>
                        @foreach (var item in tab.Items)
                        {
                            <div class="rail-item">
                                <partial name="_VehicleCard" model="item" />
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>
