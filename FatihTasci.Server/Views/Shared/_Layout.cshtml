@inject FatihTasci.Core.Service.Domains.Abstracts.ISiteSettingService SettingService
@{
    var settings = await SettingService.GetAsync();
    var galleryName = SiteFormat.GalleryName(settings);
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(pageTitle) ? galleryName : $"{pageTitle} | {galleryName}";
    var description = SiteFormat.Truncate(ViewData["Description"] as string ?? $"{galleryName} — {ShareCards.SiteTagline.ToLower(new System.Globalization.CultureInfo("tr-TR"))}.");
    // SEO: canonical ve og:url tam adres (Site:BaseUrl), og:image 1200×630 paylaşım görseli (ShareImageController)
    var canonical = ViewData["Canonical"] as string;
    var canonicalUrl = Urls.Absolute(Context.Request, canonical);
    var pageUrl = canonicalUrl ?? Urls.Absolute(Context.Request, Context.Request.Path);
    var ogImage = Urls.Absolute(Context.Request, ViewData["OgImage"] as string ?? ShareCards.SiteImagePath);
    var ogImageAlt = ViewData["OgImageAlt"] as string ?? galleryName;
    var ogType = ViewData["OgType"] as string ?? "website";
    var robots = ViewData["Robots"] as string;
    var whatsApp = SiteFormat.WhatsAppLink(settings.WhatsApp, ViewData["WhatsAppMessage"] as string ?? "Merhaba, araçlarınız hakkında bilgi almak istiyorum.");
    var tel = SiteFormat.TelLink(settings.Phone);
    // İlan sayfası, ilan yetkilisinin numaralarıyla mobil çubuğu değiştirebilir.
    var pageWhatsApp = ViewData["PageWhatsApp"] as string ?? whatsApp;
    var pageTel = ViewData["PageTel"] as string ?? tel;
    var path = Context.Request.Path.Value ?? "/";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    @if (robots != null)
    {
        <meta name="robots" content="@robots" />
    }
    @if (canonicalUrl != null)
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <meta property="og:type" content="@ogType" />
    <meta property="og:site_name" content="@galleryName" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@pageUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="@ogImageAlt" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />
    <meta name="theme-color" content="#FFFFFF" />
    @* Türkçe metinde latin ve latin-ext birlikte gerekir; ilk çizimde beklememek için önceden yüklenir *@
    <link rel="preload" href="/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <header class="site-header">
        <div class="container header-inner">
            @* Logo firma adını içeren kelime logosudur: logo varsa ad ayrıca yazılmaz (alt metni addır). *@
            <a class="brand" href="/">
                @if (settings.LogoUrl != null)
                {
                    <img class="brand-mark" src="@settings.LogoUrl" alt="@galleryName" />
                }
                else
                {
                    <span>@galleryName</span>
                }
            </a>
            <nav class="main-nav" aria-label="Ana menü">
                <a href="/" class="nav-home @(path == "/" ? "active" : null)">Ana Sayfa</a>
                <a href="/ilanlar" class="@(path.StartsWith("/ilanlar") || path.StartsWith("/arac") ? "active" : null)">Tüm İlanlar</a>
                <a href="/hizmetler" class="@(path.StartsWith("/hizmetler") ? "active" : null)">Hizmetler</a>
                <a href="/teslimatlar" class="@(path.StartsWith("/teslimatlar") ? "active" : null)">Teslimatlar</a>
                <a href="/kurumsal" class="@(path.StartsWith("/kurumsal") ? "active" : null)">Kurumsal</a>
                <a href="/iletisim" class="@(path.StartsWith("/iletisim") ? "active" : null)">İletişim</a>
            </nav>
            @if (tel != null)
            {
                <a class="btn btn-primary header-phone" href="@tel" aria-label="Bizi arayın: @settings.Phone">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                        <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" />
                    </svg>
                    <span>@settings.Phone</span>
                </a>
            }
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-brand">
                <a class="brand" href="/">
                    @if (settings.LogoUrl != null)
                    {
                        <img class="brand-mark" src="@settings.LogoUrl" alt="@galleryName" />
                    }
                    else
                    {
                        <span>@galleryName</span>
                    }
                </a>
                @if (!string.IsNullOrWhiteSpace(settings.Address))
                {
                    <p class="muted">@settings.Address</p>
                }
                @if (!string.IsNullOrWhiteSpace(settings.WorkingHours))
                {
                    <p class="muted">@settings.WorkingHours</p>
                }
                @if (MapLinks.HasLocation(settings))
                {
                    <p><a class="footer-strong" href="@MapLinks.Directions(settings)" target="_blank" rel="noopener">Yol tarifi al</a></p>
                }
            </div>
            <div>
                <h2 class="footer-title">İlanlar</h2>
                <p><a href="/ilanlar">Tüm İlanlar</a></p>
                <p><a href="/teslimatlar">Teslimatlar</a></p>
                <p><a href="/hizmetler">Hizmetler</a></p>
            </div>
            <div>
                <h2 class="footer-title">Kurumsal</h2>
                <p><a href="/kurumsal">Hakkımızda</a></p>
                <p><a href="/iletisim">İletişim</a></p>
                <p><a href="/kvkk">KVKK Aydınlatma Metni</a></p>
            </div>
            <div>
                <h2 class="footer-title">İletişim</h2>
                @if (tel != null)
                {
                    <p><a class="footer-strong" href="@tel">@settings.Phone</a></p>
                }
                @if (!string.IsNullOrWhiteSpace(settings.Email))
                {
                    <p><a href="mailto:@settings.Email">@settings.Email</a></p>
                }
                @if (whatsApp != null)
                {
                    <p><a href="@whatsApp" target="_blank" rel="noopener">WhatsApp</a></p>
                }
            </div>
        </div>
        <div class="container footer-bottom">
            <span class="muted">© @DateTime.Now.Year @galleryName</span>
            <partial name="_SocialLinks" model="settings.SocialLinks" />
        </div>
    </footer>

    @if (pageTel != null || pageWhatsApp != null)
    {
        <div class="mobile-bar">
            @if (pageTel != null)
            {
                <a class="btn btn-outline" href="@pageTel">Ara</a>
            }
            @if (pageWhatsApp != null)
            {
                <a class="btn btn-primary" href="@pageWhatsApp" target="_blank" rel="noopener">WhatsApp</a>
            }
        </div>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
