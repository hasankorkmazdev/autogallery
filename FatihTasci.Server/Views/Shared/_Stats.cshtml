@model List<StatItemModel>
@*
    "Sayılarla Biz" (ana sayfa ve Kurumsal). Rakamlar panelde Site İçeriği'nden gelir; liste boşsa bölüm görünmez.
    Rakamlar sabittir, sayma animasyonu yoktur (CLAUDE.md: sayaç yok).
*@
@{
    // Kurumsal sayfasında kendi sayfasına bağlantı verilmez.
    var showLink = !string.Equals(Context.Request.Path.Value, "/kurumsal", StringComparison.OrdinalIgnoreCase);
}
@if (Model.Count > 0)
{
    <section class="section stats" aria-labelledby="stats-title">
        <div class="container">
            @* Koyu, yuvarlak köşeli blok: beyaz sayfada galerinin siyah + altın kurumsal rengi *@
            <div class="stats-box">
            <div class="stats-head">
                <h2 id="stats-title" class="section-title">Sayılarla Biz</h2>
                @if (showLink)
                {
                    <a href="/kurumsal">Bizi tanıyın</a>
                }
            </div>
            <dl class="stats-grid">
                @foreach (var stat in Model)
                {
                    <div class="stat">
                        <dt class="stat-label">@stat.Label</dt>
                        <dd class="stat-value">@stat.Value</dd>
                    </div>
                }
            </dl>
            </div>
        </div>
    </section>
}
