@model List<FilterOptionModel>
@*
    Stokta aracı olan markalar, logolarıyla. Logolar koyu zeminde de okunsun diye açık bir kutuda gösterilir.
    ViewData["ActiveBrand"]: seçili marka slug'ı (stok sayfasında vurgulanır).
*@
@{
    var active = ViewData["ActiveBrand"] as string;
}
@if (Model.Count > 0)
{
    <nav class="brand-strip" aria-label="Markalar">
        @foreach (var brand in Model)
        {
            <a class="brand-chip @(brand.Value == active ? "active" : null)" href="/stok/@brand.Value" title="@brand.Label (@brand.Count araç)">
                <span class="brand-logo">
                    @if (!string.IsNullOrEmpty(brand.LogoUrl))
                    {
                        <img src="@brand.LogoUrl" alt="" width="40" height="40" loading="lazy" />
                    }
                </span>
                <span class="brand-name">@brand.Label</span>
                <span class="brand-count">@brand.Count</span>
            </a>
        }
    </nav>
}
