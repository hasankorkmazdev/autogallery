@model List<VehicleCardModel>
@*
    "Fırsat Araçları" şeridi: panelde "Fırsat aracı" işaretli araçların adı ve fiyatı borsa bandı gibi akar.
    Liste iki kez yazılır (ikincisi ekran okuyuculardan gizli) ki döngü kesintisiz olsun; site.js [data-ticker]
    hızı genişliğe göre ayarlar ve gerekirse kopya ekler. Üzerine gelince / odaklanınca durur; "Hareketi azalt"
    açıksa akmaz, elle kaydırılır.
*@
@if (Model is { Count: > 0 })
{
    <section class="ticker" aria-labelledby="ticker-title" data-ticker>
        <h2 id="ticker-title" class="ticker-label"><a href="/ilanlar">Fırsat Araçları</a></h2>
        <div class="ticker-viewport">
            <div class="ticker-track" data-ticker-track>
                @for (var copy = 0; copy < 2; copy++)
                {
                    var hidden = copy > 0;
                    <ul class="ticker-group" aria-hidden="@(hidden ? "true" : null)">
                        @foreach (var item in Model)
                        {
                            <li>
                                <a class="ticker-item" href="@item.Url" tabindex="@(hidden ? "-1" : null)">
                                    <span class="ticker-name">@item.Title</span>
                                    <span class="ticker-price">@SiteFormat.PriceTag(item.Price, item.CampaignPrice, item.ShowPrice)</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </section>
}
